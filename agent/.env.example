PORT=8001
AGENT_SHARED_SECRET=
BACKEND_CALLBACK_URL=
# fake | hybrid | live
PATCHLOOP_MODE=
# graph (default) | loop
PATCHLOOP_ENGINE=
MAX_LIVE_RUNS=

# Nebius Token Factory (LLM) + Nebius Sandboxes
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=
LLM_MAX_TOKENS=
LLM_TIMEOUT=
MAX_ROUNDS=
SANDBOX_CONCURRENCY=

# Budgets per run (exceeding stops the run with an error event)
RUN_MAX_TOKENS=
RUN_MAX_SECONDS=
RUN_MAX_CANDIDATES=
POLICY_MAX_DIFF_LINES=

# Guardrails (NeMo): auto | heuristic | self | nebius | nvidia
GUARD_BACKEND=
# closed | open (empty: closed for live/hybrid, open for fake/replay)
GUARD_FAIL_MODE=
GUARD_TIMEOUT=
NVIDIA_API_KEY=

# GitHub PRs
GITHUB_TOKEN=
GITHUB_REPO=

# Observability (all no-ops when unset)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=
NEW_RELIC_AI_MONITORING_ENABLED=
LOG_LEVEL=

# Fake-mode pacing multiplier (1.0 = demo speed)
FAKE_DELAY_SCALE=

# Repo tasks. Per-run GitHub tokens come from the backend (never set here).
# Real repos run only in Nebius Sandboxes unless this is 1 (runs their tests on THIS host: dev only).
ALLOW_LOCAL_REPO_EXEC=
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=

# Eval pipeline (evals/README.md). With none of these set, LLM-judged metrics are skipped (needs_judge).
# Judge model id on the Nebius Token Factory (OpenAI compatible; key = NEBIUS_API_KEY)
EVAL_JUDGE_MODEL=
# Optional embeddings model (only AnswerCorrectness / AnswerRelevancy in Ragas need it)
EVAL_EMBED_MODEL=
# Optional: point the judge at another OpenAI-compatible endpoint
EVAL_JUDGE_BASE_URL=

# Agent swarm caps (app/swarm). The planner and POST /repo-runs `limits` are clamped to these.
SWARM_MAX_WORKERS=8
SWARM_MAX_TOKENS=400000
SWARM_MAX_WALL_S=900
SWARM_WORKER_MAX_STEPS=30
SWARM_MAX_ROUNDS=3
SWARM_MAX_UNITS=12
# auto (try native tool calls, fall back to a JSON action loop) | native | json
SWARM_TOOL_MODE=
