PORT=8080

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=patchloop

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Clerk (browser auth): Dashboard -> API keys. Required.
CLERK_SECRET_KEY=sk_test_your_key

# Required unless DEV_MODE=true
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@patchloop.dev

FRONTEND_ORIGIN=http://localhost:3000
# Base URL used in links (Slack buttons). Defaults to FRONTEND_ORIGIN.
PUBLIC_APP_URL=http://localhost:3000

OTP_TTL_MIN=10

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Internal agent service (never exposed to browsers). Required secret.
AGENT_URL=http://localhost:8001
AGENT_SHARED_SECRET=change-me-agent-secret

# Limits
LIVE_RUNS_PER_USER_PER_DAY=10
GUEST_RUNS_PER_HOUR=3
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (empty = none)
TRUSTED_PROXIES=

# Optional: global Slack incoming webhook for "fix ready" alerts (users can set their own)
SLACK_WEBHOOK_URL=

# ---- GitHub App (without it only the offline demo account works) -------------
# Create the App as described in docs/SETUP.md. Setup URL = ${PUBLIC_URL}/api/github/callback
# (enable "Request user authorization (OAuth) during installation"),
# webhook URL = ${PUBLIC_URL}/api/github/webhook.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM, or base64 of the PEM (newlines may be written as \n)
GITHUB_APP_PRIVATE_KEY=
# The App's user-authorization credentials: merges run with the USER's permission
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Public base URL of this backend, and where to send the browser after install
PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
# base64 of 32 random bytes (openssl rand -base64 32). Encrypts GitHub tokens and
# Slack webhooks at rest (AES-256-GCM). Unset + DEV_MODE=true derives a key from
# JWT_ACCESS_SECRET; unset otherwise = tokens/webhooks cannot be stored.
TOKEN_ENC_KEY=
# Repo tasks per user per hour (web, CLI, Slack and GitHub triggers share it)
TASKS_PER_USER_PER_HOUR=10
# Demo accounts: how long the fake CI of a demo PR stays "pending" (Merge is refused meanwhile)
DEMO_CHECKS_PENDING_SEC=4
# Test overrides only (GitHub Enterprise / stubs)
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# ---- Slack workspace app (optional) -------------------------------------------
# Commands/events/interactions URLs: ${PUBLIC_URL}/slack/commands, /slack/events,
# /slack/interactions. Scopes: commands app_mentions:read chat:write
# channels:history groups:history
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Point at the fake Slack API for offline demos (go run ./cmd/slackdev serve -addr :19090)
SLACK_API_BASE=

# Optional: New Relic APM (no-op when the key is empty)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=patchloop-backend

# Test-only. Keeps OTPs in memory, readable at GET /internal/dev/otp?email=
# (X-Agent-Secret required) and allows an empty RESEND_API_KEY. Never in prod.
DEV_MODE=false
