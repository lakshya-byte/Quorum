PORT=8080

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=patchloop

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Required unless DEV_MODE=true
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@patchloop.dev

FRONTEND_ORIGIN=http://localhost:3000
# Base URL used in links (Slack buttons). Defaults to FRONTEND_ORIGIN.
PUBLIC_APP_URL=http://localhost:3000

OTP_TTL_MIN=10

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Internal agent service (never exposed to browsers). Required secret.
AGENT_URL=http://localhost:8001
AGENT_SHARED_SECRET=change-me-agent-secret

# Limits
LIVE_RUNS_PER_USER_PER_DAY=10
GUEST_RUNS_PER_HOUR=3
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (empty = none)
TRUSTED_PROXIES=

# Optional: Slack incoming webhook for "fix ready" alerts
SLACK_WEBHOOK_URL=

# Optional: New Relic APM (no-op when the key is empty)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=patchloop-backend

# Test-only. Keeps OTPs in memory, readable at GET /internal/dev/otp?email=
# (X-Agent-Secret required) and allows an empty RESEND_API_KEY. Never in prod.
DEV_MODE=false
